{
  "name": "medo-game-launcher",
  "private": true,
  "version": "0.3.1",
  "description": "Premium Discord Activity Launcher",
  "author": "mghonem2500-tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/mghonem2500-tech/DiscordGameLauncher.git"
  },
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "sync:gamelist": "node ./scripts/sync-gamelist.js",
    "test": "node --test",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/game-list.js && node --check src/persistence.js && node --check src/renderer/renderer.js && node --check scripts/sync-gamelist.js && node --check scripts/validate-package.js && npm test",
    "validate:template": "node ./scripts/validate-package.js",
    "validate:package": "node ./scripts/validate-package.js --packaged",
    "build:dummy": "dotnet build ../src/DummyGame/DummyGame.csproj -c Release",
    "build:launcher": "dotnet build ../src/Launcher/Launcher.csproj -c Release",
    "dist": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:publish": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "build": {
    "appId": "com.mghonem2500.medo-game-launcher",
    "productName": "Medo Game Launcher",
    "artifactName": "Medo.Game.Launcher.Setup.${version}.${ext}",
    "icon": "icon.ico",
    "files": [
      "src/**"
    ],
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "afterPack": "scripts/afterPack.js",
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "medo-icon.ico"
      },
      {
        "from": "build-resources/dummygame",
        "to": "dummygame",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mghonem2500-tech",
        "repo": "DiscordGameLauncher"
      }
    ],
    "protocols": [
      {
        "name": "Medo Game Launcher Share",
        "schemes": [
          "medo-launcher"
        ]
      }
    ],
    "nsis": {
      "include": "installer.nsh",
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Medo Game Launcher"
    }
  }
}
